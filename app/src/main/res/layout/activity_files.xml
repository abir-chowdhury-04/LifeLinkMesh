<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtFileHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="Tap a connected phone, then choose a file to send. The other phone must accept first."
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFilePeers"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_below="@id/txtFileHint"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/txtFileStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/recyclerFilePeers"
        android:layout_marginTop="6dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtReceivedLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtFileStatus"
        android:layout_marginTop="10dp"
        android:text="Received files (tap to open)"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerReceived"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtReceivedLabel" />
</RelativeLayout>